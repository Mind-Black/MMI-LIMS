# MMI-LIMS Environment Variables Configuration
# Copy this file to .env and supply your project values:

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Edge Function secrets (names only). These are set in Supabase with
# `supabase secrets set`, never in this file, .env, or GitHub.
#   RESEND_API_KEY, NOTIFICATION_WORKER_SECRET, MS_BOOKINGS_SYNC_SECRET, EMAIL_FROM, SITE_URL
# NOTIFICATION_WORKER_SECRET must match the Vault secret
# mmi_notification_worker_secret (see docs/OPERATIONS.md).

# Optional: Custom deployment base path (defaults to /MMI-LIMS/ for GitHub Pages)
# VITE_BASE_PATH=/MMI-LIMS/
